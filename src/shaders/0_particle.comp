#version 450
// Work group size for the compute_shader
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
struct Particle
{
    vec4 position_lifetime;
    vec4 velocity_size;
    vec4 color; 
};

layout(std430, binding = 0) buffer ParticleBufferData
{
    Particle particles[];
};

layout(location = 0) uniform float uDeltaTime; // Assuming a fixed time step of 16ms (60 FPS)
layout(binding = 0) uniform sampler2D uNormalTex;
layout(binding = 2) uniform sampler2D uDepthTex;
layout(location = 1) uniform mat4 uView;
layout(location = 2) uniform mat4 uProjection;


void Update(float deltaTime, inout Particle pParticle, uint pIndex)
{
    float gravity = -9.81f; // Gravity acceleration in m/s^2
    pParticle.velocity_size.y += gravity * deltaTime; // Apply gravity to the y-velocity
    pParticle.position_lifetime.x += pParticle.velocity_size.x * deltaTime;
    pParticle.position_lifetime.y += pParticle.velocity_size.y * deltaTime;
    pParticle.position_lifetime.z += pParticle.velocity_size.z * deltaTime;
    pParticle.position_lifetime.w -= deltaTime;
    particles[pIndex] = pParticle;
}

// A widely used PRNG hash function (PCG or similar integer hash)
// https://gist.github.com/keijiro/24f9d505fac238c9a2982c0d6911d8e3
// Hash function from H. Schechter & R. Bridson, goo.gl/RXiKaH
uint randomInt(inout uint state) {
    state ^= 2747636419u;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    return state;
}

// Returns a random float between 0.0 and 1.0
float randomFloat(inout uint state) {
    return float(randomInt(state)) / 4294967295.0; // Divide by max uint
}

// Helper to get a random float within a specific range
float randomRange(inout uint state, float minVal, float maxVal) {
    return mix(minVal, maxVal, randomFloat(state));
}


void ResetParticle(inout Particle pParticle, inout uint seed)
{
    pParticle.position_lifetime = vec4(
        randomRange(seed, -5.0,  5.0),  // Random x position between -5 and 5
        randomRange(seed,  5.0, 10.0),  // Random y position between -5 and 5
        randomRange(seed, -5.0,  5.0),  // Random z position between -5 and 5
        2.0                          // Reset lifetime to 1 second
    );

    pParticle.velocity_size = vec4(
        randomRange(seed, -1.0, 1.0),  // Random x velocity between -1 and 1
        randomRange(seed, -1.0, 1.0),  // Random y velocity between -1 and 1
        randomRange(seed, -1.0, 1.0),  // Random z velocity between -1 and 1
        randomRange(seed, 0.1, 0.3)    // Random size between 1 and 3
    );

    pParticle.color = vec4(
        randomFloat(seed),             // Random red component (0.0 to 1.0)
        randomFloat(seed),             // Random green component (0.0 to 1.0)
        randomFloat(seed),             // Random blue component (0.0 to 1.0)
        1.0                          // Full opacity
    );
}


void main()
{
    // Out of bounds, do nothing
    uint index = gl_GlobalInvocationID.x;
    if(index >= particles.length()) return;

    Particle vParticle = particles[index];
    float thickness = 0.01;
    // https://gamedev.stackexchange.com/questions/8718/glsl-how-do-i-cast-a-float-to-an-int
    highp int intDeltatime = int(uDeltaTime * 1000.0); // Convert delta time to milliseconds
    uint seed = index * intDeltatime; // Create a seed based on index and delta time
    randomInt(seed); // Initialize the random number generator with the seed

    vec4 clipSpacePos = uProjection*uView*vec4(vParticle.position_lifetime.xyz, 1.0);
    vec3 ndcSpacePos = clipSpacePos.xyz / clipSpacePos.w; // Convert to NDC space
    vec2 lUV = ndcSpacePos.xy * 0.5 + 0.5; // Convert to texture coordinates (0 to 1)

    float depthValue = texture(uDepthTex, lUV).r; // Sample the depth
    float particleDepth = ndcSpacePos.z * 0.5 + 0.5; // Convert particle depth to [0, 1] range

    vec3 surfaceNormal = texture(uNormalTex,lUV).xyz;

    // Do not do the collision computation if the particle is outside the screen bounds
    if(lUV.x > 0.0 && lUV.x < 1.0 && lUV.y > 0.0 && lUV.y < 1.0)
    {
        if(particleDepth > depthValue && particleDepth < depthValue + thickness)
        {
            float reboundRatio = 0.5; // Adjust this value to control the bounce effect
            vParticle.velocity_size.xyz = reflect(vParticle.velocity_size.xyz, surfaceNormal) * reboundRatio; // Reflect the velocity based on the surface normal
        }
    }

    Update(uDeltaTime, vParticle, index);
    
    if(vParticle.position_lifetime.w <= 0.0)
    {
        ResetParticle(vParticle, seed);
    }
    particles[index] = vParticle;
}